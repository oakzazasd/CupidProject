# ==== Cupid AI — Custom OpenAI-compatible provider ====
AI_PROVIDER_NAME=Custom Provider
AI_API_BASE_URL=https://your-provider.example/v1
AI_API_KEY=your_api_key_here

AI_VISION_MODEL=your_vision_model
AI_TEXT_MODEL=your_text_model

AI_REQUEST_TIMEOUT=90
AI_MAX_RETRIES=1
# auto = try response_format json_object then fall back to prompt-based JSON | on | off
AI_JSON_MODE=auto

# ==== App ====
# YouTube video/playlist id for heartbreak mode (empty = open YouTube search page instead)
SAD_MUSIC_YOUTUBE_ID=

# Comma-separated allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_IMAGE_MB=8

RATE_LIMIT_ANALYZE_PER_HOUR=8
RATE_LIMIT_CHAT_PER_10MIN=40
RATE_LIMIT_TEST_PER_MIN=5
